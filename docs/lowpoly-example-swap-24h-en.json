  "scenes": [
    {
      "narration": "Hour twenty three. I'm standing at the edge of the sky city. And now I know *why* the rich kid paid me to swap lives.",
      "setting": "sky_edge",
      "action": "edge_look",
      "shot": "dolly_in",
      "mood": "sunset",
      "counter": "HOUR 23"
    },
    {
      "narration": "Yesterday, I was just a kid from the slums. Then a boy from the sky city came down to find me.",
