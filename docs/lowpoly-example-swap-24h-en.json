      "action": "look_up",
      "shot": "low_angle",
      "mood": "day",
      "speaker": "leo",
      "counter": "HOUR 0"
    },
    {
      "narration": "His gold pass took me straight up the lift. The guards *bowed* to me.",
      "setting": "lift_gate",
      "action": "lift_ride",
      "shot": "side_track",
      "mood": "day",
      "counter": "HOUR 1"
    },
    {
      "narration": "Up there, everything was gold. Free food. Music. People smiling way too much.",
